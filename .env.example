# VaultRoom Environment Configuration Example
# Copy this file to .env for local development

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Security & Authentication
# Generate a secure secret using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string-for-jwt-signing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database URL (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./vaultroom.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://vault_user:vault_pass@localhost:5432/vaultroom_db

# Room Settings
ROOM_CODE_EXPIRY_HOURS=24
ROOM_MAX_PARTICIPANTS=20
INACTIVE_ROOM_TIMEOUT_MINUTES=60

# Anomaly Detection Settings
ANOMALY_DETECTION_MODE=hybrid  # 'synthetic_demo', 'real_baseline', 'hybrid'
ANOMALY_CONTAMINATION=0.05
